<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<appSettings>
		<add key="MaxActiveAuctions" value="10" />
		<add key="MaxActiveAuctionsPerCategory" value="3" />
		<add key="SeriousnessThreshold" value="5.0" />
		<add key="SimilarityThreshold" value="5" />
	</appSettings>
</configuration>